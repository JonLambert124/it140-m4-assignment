# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode

START hilow_game

    # Establish a valid guessing range.
    OUTPUT "Enter the lower bound:"
    INPUT lowerBound

    OUTPUT "Enter the upper bound:"
    INPUT upperBound

    WHILE lowerBound >= upperBound
        OUTPUT "The lower bound must be less than the upper bound."

        OUTPUT "Enter the lower bound:"
        INPUT lowerBound

        OUTPUT "Enter the upper bound:"
        INPUT upperBound
    END WHILE

    # Establish the number the player is trying to guess.
    SET secretNumber = RANDOM number between lowerBound and upperBound
    SET correctGuess = false

    # Play the game.
    WHILE correctGuess = false
        OUTPUT "Enter a guess between " + lowerBound + " and " + upperBound + ":"
        INPUT guess

        # Validate the guess before comparing it with the secret number.
        WHILE guess < lowerBound OR guess > upperBound
            OUTPUT "Your guess must be between " + lowerBound + " and " + upperBound + "."
            OUTPUT "Enter another guess:"
            INPUT guess
        END WHILE

        # Compare the valid guess and provide feedback.
        IF guess < secretNumber
            OUTPUT "Nope, too low."
        ELSE IF guess > secretNumber
            OUTPUT "Nope, too high."
        ELSE
            OUTPUT "You got it!"
            SET correctGuess = true
        END IF
    END WHILE

END hilow_game
